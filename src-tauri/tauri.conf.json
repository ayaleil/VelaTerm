{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VelaTerm",
  "version": "0.2.14",
  "identifier": "io.vlinx.vlxterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VelaTerm",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#23262b",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/eperfecto/VelaTerm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NDZBNTRDRTU4NTdBNzkKUldSNWVvWGxUS1ZHaWFEaWJYQjRaY0VrOFpSakp0ODRSQW85WDI1OGo0VXRDaEZQTktzTm5uOU4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
